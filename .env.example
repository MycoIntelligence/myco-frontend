NEXT_PUBLIC_APP_URL=https://app.veldt.dev
NEXT_PUBLIC_SITE_URL=https://veldt.dev
MYCO_DASHBOARD_URL=
NEXT_PUBLIC_MYCO_DASHBOARD_URL=


# Server-only pilot request endpoint (HTTPS); configure before launch.
LEAD_WEBHOOK_URL=
# Optional bearer token for the endpoint.
LEAD_WEBHOOK_TOKEN=

# Server-only Resend settings for trial request emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TRIAL_REQUEST_TO=

# Server-only credentials for website accounts. See supabase/README.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
WEBSITE_LOGIN_NAMESPACE_KEY=

# Razorpay Standard Checkout. Use test keys in Preview and local development.
# Live keys require VERCEL_ENV=production, supplied by Vercel's system environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MONTHLY_AMOUNT_PAISE=
RAZORPAY_ANNUAL_AMOUNT_PAISE=

# Firebase Authentication (Website Google & GitHub Sign-In)
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
