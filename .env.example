# ==============================================================================
# Myco Assistant & Pipeline Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM Inference Service (RAG Answer Generation)
# ------------------------------------------------------------------------------
# API key obtained from https://console.groq.com/keys
# Server-side only: NEVER expose this key in client-side bundles or repository commits.
GROQ_API_KEY=
# Fallback alias supported in legacy backend configs
MYCO_LLM_API_KEY=

# Supported Groq models:
# - llama-3.3-70b-versatile (Recommended: highest reasoning quality, 128k context)
# - llama-3.1-8b-instant    (High-speed alternative: lowest latency)
# - mixtral-8x7b-32768      (MoE balanced option)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=800

# ------------------------------------------------------------------------------
# 2. RAG Retrieval & Evidence Calibration Settings
# ------------------------------------------------------------------------------
# Minimum combined score for a chunk to be considered relevant
RAG_SIMILARITY_THRESHOLD=0.35

# Minimum score required to answer affirmatively rather than triggering honest refusal
RAG_ANSWERABILITY_THRESHOLD=0.42

# Fusion weights for Hybrid Retrieval (Vector + Lexical BM25, sum = 1.0)
RAG_HYBRID_VECTOR_WEIGHT=0.65
RAG_HYBRID_LEXICAL_WEIGHT=0.35

# Directory containing approved markdown documentation sources
RAG_KNOWLEDGE_DIR=pipeline/rag/documents

# Persistent cache file for pre-indexed chunks and vectors
RAG_INDEX_CACHE_PATH=pipeline/rag/index_cache.json

# ------------------------------------------------------------------------------
# 3. Human Escalation & Notification Services (Resend Email Provider)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
PILOT_EMAIL_FROM=onboarding@resend.dev
PILOT_EMAIL_TO=team@mycointelligence.com

# Optional: dedicated inbox for chatbot visitor escalations (defaults to PILOT_EMAIL_TO)
CHAT_ESCALATION_EMAIL_TO=pilot@mycointelligence.com

# ------------------------------------------------------------------------------
# 4. GitHub Data Fetching & Integration Service
# ------------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained) for higher API rate limits (5,000 req/hr)
# and access to private repositories or organization pull requests.
GITHUB_TOKEN=
GH_TOKEN=

# Optional: Remote GitHub repository for live documentation indexing
# Format: "owner/repo" (e.g. "myco-intelligence/docs")
GITHUB_DOCS_REPO=
GITHUB_DOCS_PATH=docs
GITHUB_DOCS_REF=main

# ------------------------------------------------------------------------------
# 5. Local Offline Testing Overrides (.env Mock Mode)
# ------------------------------------------------------------------------------
# When set, the pipeline will return these mock fixtures instead of making real
# GitHub API network calls. Ideal for hermetic CI and offline test suites.
# TEST_GITHUB_PR_DIFF="diff --git a/src/app.ts b/src/app.ts\n+const version = '2.0.0';"
# TEST_GITHUB_FILE_CONTENT="export const config = { enabled: true };"
